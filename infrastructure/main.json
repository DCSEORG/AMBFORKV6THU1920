              "value": "[parameters('sqlServerName')]"
            },
            "databaseName": {
              "type": "string",
              "value": "[variables('databaseName')]"
            }
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Resources/deployments', 'managedIdentityDeployment')]"
      ]
