@page
@model ExpenseManagement.Pages.AddExpenseModel
@{
    ViewData["Title"] = "Add Expense";
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="error-banner">
        <div class="error-icon">⚠️</div>
        <div class="error-content">
            <strong>Error</strong>
            <p>@Model.ErrorMessage</p>
        </div>
    </div>
}

<div class="page-container">
    <header class="page-header">
        <h1>Add Expense</h1>
        <a href="/Index" class="btn btn-secondary">← Back to Expenses</a>
    </header>

    <div class="form-container">
        <form method="post" class="expense-form">
            <div class="form-group">
                <label for="Amount">Amount (£):</label>
                <input type="number" id="Amount" name="Input.Amount" step="0.01" min="0.01" required class="form-input" />
            </div>

            <div class="form-group">
                <label for="ExpenseDate">Date:</label>
                <input type="date" id="ExpenseDate" name="Input.ExpenseDate" required class="form-input" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>

            <div class="form-group">
                <label for="CategoryId">Category:</label>
                <select id="CategoryId" name="Input.CategoryId" required class="form-select">
                    <option value="">Select a category</option>
                    @foreach (var category in Model.Categories)
                    {
                        <option value="@category.CategoryId">@category.CategoryName</option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label for="UserId">Employee:</label>
                <select id="UserId" name="Input.UserId" required class="form-select">
                    @foreach (var user in Model.Users)
                    {
                        <option value="@user.UserId">@user.UserName</option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label for="Description">Description:</label>
                <textarea id="Description" name="Input.Description" rows="4" class="form-textarea" placeholder="Enter expense description..."></textarea>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Submit</button>
                <a href="/Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
