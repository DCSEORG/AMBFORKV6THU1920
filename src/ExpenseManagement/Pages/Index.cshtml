@page
@model ExpenseManagement.Pages.IndexModel
@{
    ViewData["Title"] = "Expenses";
}

@if (Model.ShowError)
{
    <div class="error-banner">
        <div class="error-icon">⚠️</div>
        <div class="error-content">
            <strong>Database Connection Error</strong>
            <p>@Model.ErrorMessage</p>
            <small>Currently showing dummy data for demonstration purposes.</small>
        </div>
    </div>
}

<div class="page-container">
    <header class="page-header">
        <h1>Expenses</h1>
        <div class="header-actions">
            <a href="/AddExpense" class="btn btn-primary">+ Add Expense</a>
            <a href="/Approve" class="btn btn-secondary">Approve Expenses</a>
            <a href="/Chat" class="btn btn-chat">💬 Chat</a>
        </div>
    </header>

    <div class="filter-section">
        <form method="get" class="filter-form">
            <div class="filter-group">
                <label for="filter">Filter:</label>
                <input type="text" id="filter" name="filter" value="@Model.Filter" placeholder="Search expenses..." class="filter-input" />
            </div>
            <div class="filter-group">
                <label for="statusFilter">Status:</label>
                <select id="statusFilter" name="statusFilter" class="filter-select">
                    <option value="">All Statuses</option>
                    @foreach (var status in Model.Statuses)
                    {
                        <option value="@status.StatusName" selected="@(Model.StatusFilter == status.StatusName)">@status.StatusName</option>
                    }
                </select>
            </div>
            <div class="filter-group">
                <label for="categoryFilter">Category:</label>
                <select id="categoryFilter" name="categoryFilter" class="filter-select">
                    <option value="">All Categories</option>
                    @foreach (var category in Model.Categories)
                    {
                        <option value="@category.CategoryId" selected="@(Model.CategoryFilter == category.CategoryId)">@category.CategoryName</option>
                    }
                </select>
            </div>
            <button type="submit" class="btn btn-filter">Apply Filter</button>
        </form>
    </div>

    <div class="expenses-table-container">
        <table class="expenses-table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Category</th>
                    <th>Amount</th>
                    <th>Status</th>
                    <th>Description</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Expenses.Any())
                {
                    @foreach (var expense in Model.Expenses)
                    {
                        <tr class="expense-row status-@expense.StatusName.ToLower()">
                            <td>@expense.ExpenseDate.ToString("dd/MM/yyyy")</td>
                            <td>@expense.CategoryName</td>
                            <td class="amount">£@expense.AmountGBP.ToString("N2")</td>
                            <td>
                                <span class="status-badge status-@expense.StatusName.ToLower()">@expense.StatusName</span>
                            </td>
                            <td class="description">@(expense.Description ?? "-")</td>
                            <td class="actions">
                                @if (expense.StatusName == "Draft")
                                {
                                    <form method="post" asp-page-handler="Submit" asp-route-id="@expense.ExpenseId" style="display:inline;">
                                        <button type="submit" class="btn btn-small btn-submit">Submit</button>
                                    </form>
                                    <a href="/EditExpense?id=@expense.ExpenseId" class="btn btn-small btn-edit">Edit</a>
                                    <form method="post" asp-page-handler="Delete" asp-route-id="@expense.ExpenseId" style="display:inline;">
                                        <button type="submit" class="btn btn-small btn-delete" onclick="return confirm('Are you sure you want to delete this expense?')">Delete</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="no-data">No expenses found</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.Expenses.Any())
    {
        <div class="summary-section">
            <div class="summary-card">
                <span class="summary-label">Total Expenses:</span>
                <span class="summary-value">@Model.Expenses.Count</span>
            </div>
            <div class="summary-card">
                <span class="summary-label">Total Amount:</span>
                <span class="summary-value">£@Model.Expenses.Sum(e => e.AmountGBP).ToString("N2")</span>
            </div>
        </div>
    }
</div>
